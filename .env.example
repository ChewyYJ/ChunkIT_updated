LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Person 2 — Daytona context processing
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_BACKEND=local
DAYTONA_WORKER_COUNT=2
DAYTONA_WORKER_PORT=8000
DAYTONA_CHILD_AUTO_STOP_MINUTES=15
DAYTONA_SANDBOX_PREFIX=chunkit

# Gateway behavior
CHUNKIT_TARGET_TOKENS=2000
CHUNKIT_MAX_RETRIEVAL_ROUNDS=2
CHUNKIT_UPSTREAM_TIMEOUT_SECONDS=30
CHUNKIT_PRICE_PER_MTOK=15
# CHUNKIT_DB_PATH=data/sessions.db   # override the SQLite location if needed

# Anthropic front (Claude Code via ANTHROPIC_BASE_URL) — client auth is
# forwarded verbatim to this upstream; ChunkIT never needs its own key here
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
CHUNKIT_ANTHROPIC_TARGET_TOKENS=6000

# Person 3 — runtime scoring settings used by the gateway
NOSANA_ENABLED=true
NOSANA_SCORER_URL=
NOSANA_SCORER_TOKEN=
NOSANA_TIMEOUT_SECONDS=5
NOSANA_MAX_RETRIES=2
NOSANA_REQUEST_BATCH_SIZE=128
NOSANA_FALLBACK_ENABLED=true

# Deployment-management values; do not send these to the scorer container
NOSANA_API_KEY=
NOSANA_API_BASE_URL=https://dashboard.k8s.prd.nos.ci/api
NOSANA_DEPLOYMENT_ID=
NOSANA_MARKET=

# Scorer CONTAINER env (set in nosana/deployment.template.json / docker run,
# not read by the gateway): MODEL_NAME, MAX_LENGTH, BATCH_SIZE, MAX_ITEMS,
# SCORER_TOKEN — see nosana-service/server.py and nosana/DEPLOYMENT.md.
# Manual build/push values (local shell only, never read by any code):
DOCKER_USERNAME=perynnneo
DOCKER_TOKEN=
DOCKER_IMAGE=docker.io/perynnneo/chunkit-nosana-scorer
IMAGE_TAG=hackathon

# Optional live test switch
RUN_LIVE_NOSANA_TESTS=0
